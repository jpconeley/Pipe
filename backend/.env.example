PVF_DATABASE_URL=postgresql+psycopg://pvf:pvf@localhost:5432/pvf
PVF_WEB_URL=http://localhost:3000

# Freight estimate assumptions (flatbed truckload, used by the matching engine
# to rank asks by delivered price). Tune these to real lane rates later.
PVF_FREIGHT_RATE_PER_MILE=2.25
PVF_FREIGHT_MIN_PER_LOAD=350
PVF_TRUCK_CAPACITY_TONS=20
